# Copy this file to .env and fill in real values. .env is git-ignored and
# read by load_env.py at build time (see platformio.ini's extra_scripts) --
# nothing here ever needs to be typed into telemetry_config.h directly.
# Only uncomment/set the lines relevant to the transport mode you're using.

# ---- Mode Select ----
# 1 = WiFi bench testing, 0 = cellular (default)
TELEMETRY_USE_WIFI=1

# ---- WiFi Settings (TELEMETRY_USE_WIFI=1) ----
# SoftAP mode: 1 = ESP32 hosts 'esp32-telemetry' AP (default for field test with no WiFi)
# Station mode: 0 = ESP32 joins existing network (set WIFI_SSID/WIFI_PASSWORD below)
WIFI_AP_MODE=1

# SoftAP mode settings (WIFI_AP_MODE=1) -- network the ESP32 broadcasts:
WIFI_AP_SSID=esp32-telemetry
WIFI_AP_PASSWORD=telemetry123

# Station mode, ordinary WPA2/WPA3-Personal network (WIFI_AP_MODE=0, WIFI_ENTERPRISE=0):
# WIFI_SSID=your-wifi-ssid
# WIFI_PASSWORD=your-wifi-password

# Station mode, WPA2/WPA3-Enterprise / 802.1X network (WIFI_AP_MODE=0, WIFI_ENTERPRISE=1):
# WIFI_EAP_IDENTITY=
# WIFI_EAP_USERNAME=your-network-username
# WIFI_EAP_PASSWORD=your-network-password

# ---- Cellular (TELEMETRY_USE_WIFI=0) ----
# TELEMETRY_APN=your.apn.here
# TELEMETRY_APN_USER=
# TELEMETRY_APN_PASS=
# TELEMETRY_GSM_PIN=

# ---- MQTT broker (any transport) ----
# MQTT_BROKER_HOST=your-broker-host
# MQTT_BROKER_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=

# ---- SMS test send (TELEMETRY_USE_WIFI=0 only) ----
# SMS_TEST_ENABLED=1
# SMS_TEST_NUMBER=+15551234567
# SMS_TEST_MESSAGE=ESP32 telemetry: SMS test OK
